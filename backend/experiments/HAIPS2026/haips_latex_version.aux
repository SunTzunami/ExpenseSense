\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Main results (validated metrics, \%). \textbf  {Bold} = best per metric. FSP = Function Selection Precision; ACS = Argument Coverage Score; AVC = Argument Value Correctness; Task Acc = F$_1$-based task accuracy; CR = strict exact-match Correct Ratio. ACS is omitted (---) where the single-agent architecture's joint output makes isolated argument coverage less meaningful. Latency and RAM are per-query averages.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:main_results}{{4}{7}{Main results (validated metrics, \%). \textbf {Bold} = best per metric. FSP = Function Selection Precision; ACS = Argument Coverage Score; AVC = Argument Value Correctness; Task Acc = F$_1$-based task accuracy; CR = strict exact-match Correct Ratio. ACS is omitted (---) where the single-agent architecture's joint output makes isolated argument coverage less meaningful. Latency and RAM are per-query averages}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Error taxonomy breakdown (\% of test cases) per model and architecture. Single-agent Qwen3.5-2B (right panel) produces 22.6\% \texttt  {PARAM\_EXTRA} errors---spurious parameters that could lead to incorrect financial calculations. Dual-agent (left) eliminates most of these, consolidating residual errors into the more predictable \texttt  {PARAM\_MISSING} category.}}{7}{figure.caption.16}\protected@file@percent }
\newlabel{fig:error_plot}{{4}{7}{Error taxonomy breakdown (\% of test cases) per model and architecture. Single-agent Qwen3.5-2B (right panel) produces 22.6\% \texttt {PARAM\_EXTRA} errors---spurious parameters that could lead to incorrect financial calculations. Dual-agent (left) eliminates most of these, consolidating residual errors into the more predictable \texttt {PARAM\_MISSING} category}{figure.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Per-group results in dual mode (validated, \%). T.Acc = Task Accuracy, CR = Correct Ratio.}}{7}{table.caption.13}\protected@file@percent }
\newlabel{tab:category_results}{{5}{7}{Per-group results in dual mode (validated, \%). T.Acc = Task Accuracy, CR = Correct Ratio}{table.caption.13}{}}
