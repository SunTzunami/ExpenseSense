\newlabel{fig:pareto}{{1a}{6}{Accuracy--latency Pareto frontier. The dual-mode Qwen3.5-0.8B (orange square, $\approx $3~s, 89\%) sits on the efficient frontier, offering the best accuracy per unit latency. Single-mode Qwen3.5-2B reaches the highest Task Accuracy (92\%) but at 4$\times $ the latency (12~s)}{figure.caption.11}{}}
\newlabel{sub@fig:pareto}{{a}{6}{Accuracy--latency Pareto frontier. The dual-mode Qwen3.5-0.8B (orange square, $\approx $3~s, 89\%) sits on the efficient frontier, offering the best accuracy per unit latency. Single-mode Qwen3.5-2B reaches the highest Task Accuracy (92\%) but at 4$\times $ the latency (12~s)}{figure.caption.11}{}}
\newlabel{fig:radar}{{1b}{6}{Task footprint (mean Task Accuracy across all models). The dual architecture (red) uniformly expands coverage over single (blue) on all five task groups, with the largest gains on time series and comparison tools}{figure.caption.11}{}}
\newlabel{sub@fig:radar}{{b}{6}{Task footprint (mean Task Accuracy across all models). The dual architecture (red) uniformly expands coverage over single (blue) on all five task groups, with the largest gains on time series and comparison tools}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces System-level results. (a) Dual-agent Qwen3.5-0.8B dominates the efficiency frontier for privacy-preserving deployments. (b) Dual-agent decomposition improves coverage across all task categories.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:overall_visuals}{{1}{6}{System-level results. (a) Dual-agent Qwen3.5-0.8B dominates the efficiency frontier for privacy-preserving deployments. (b) Dual-agent decomposition improves coverage across all task categories}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Task Accuracy (\%) by Model $\times $ Tool Category in dual mode. Qwen3.5 models achieve $>$74\% across all categories, while weaker models show pronounced gaps in comparison and time series tasks.}}{6}{figure.caption.15}\protected@file@percent }
\newlabel{fig:category_heatmap}{{2}{6}{Task Accuracy (\%) by Model $\times $ Tool Category in dual mode. Qwen3.5 models achieve $>$74\% across all categories, while weaker models show pronounced gaps in comparison and time series tasks}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Task Accuracy by complexity tier (L1/L2/L3) per model in dual mode. The Qwen3.5 family degrades gracefully with increasing complexity.}}{6}{figure.caption.16}\protected@file@percent }
\newlabel{fig:difficulty_plot}{{3}{6}{Task Accuracy by complexity tier (L1/L2/L3) per model in dual mode. The Qwen3.5 family degrades gracefully with increasing complexity}{figure.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Main results (validated metrics, \%). \textbf  {Bold} = best per metric. FSP = Function Selection Precision; ACS = Argument Completeness Score; AVC = Argument Value Correctness; Task Acc = F$_1$-based task accuracy; CR = strict exact-match Correct Ratio. ACS is omitted (---) for single-agent configurations where the joint output format makes isolated argument coverage less meaningful. Latency and RAM are per-query averages.}}{7}{table.caption.12}\protected@file@percent }
\newlabel{tab:main_results}{{4}{7}{Main results (validated metrics, \%). \textbf {Bold} = best per metric. FSP = Function Selection Precision; ACS = Argument Completeness Score; AVC = Argument Value Correctness; Task Acc = F$_1$-based task accuracy; CR = strict exact-match Correct Ratio. ACS is omitted (---) for single-agent configurations where the joint output format makes isolated argument coverage less meaningful. Latency and RAM are per-query averages}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Error taxonomy breakdown (\% of test cases) per model and architecture. Single-agent Qwen3.5-2B (right panel) produces 22.6\% \texttt  {PARAM\_EXTRA} errors---spurious parameters that could lead to incorrect financial calculations. Dual-agent (left) eliminates most of these, consolidating residual errors into the more predictable \texttt  {PARAM\_MISSING} category.}}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:error_plot}{{4}{7}{Error taxonomy breakdown (\% of test cases) per model and architecture. Single-agent Qwen3.5-2B (right panel) produces 22.6\% \texttt {PARAM\_EXTRA} errors---spurious parameters that could lead to incorrect financial calculations. Dual-agent (left) eliminates most of these, consolidating residual errors into the more predictable \texttt {PARAM\_MISSING} category}{figure.caption.17}{}}
